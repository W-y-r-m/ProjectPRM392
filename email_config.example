# Email Configuration for Gmail SMTP
# Sao chép file này thành email_config.properties và cập nhật thông tin

# Gmail SMTP Settings
smtp.host=smtp.gmail.com
smtp.port=587

# Your Gmail credentials (CHANGE THESE!)
smtp.email=your-app-email@gmail.com
smtp.password=your-16-character-app-password
smtp.name=PRM392 Job Finder

# Instructions:
# 1. Tạo Gmail account riêng cho app
# 2. Bật 2-Factor Authentication
# 3. Tạo App Password tại: https://myaccount.google.com/apppasswords
# 4. Copy App Password (16 ký tự) vào smtp.password
# 5. Đổi tên file này thành email_config.properties
