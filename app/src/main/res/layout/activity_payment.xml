<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:titleTextColor="#1F2937"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Payment Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💳 Thông tin thanh toán"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Số tiền:"
                            android:textSize="16sp"
                            android:textColor="#4B5563" />

                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100,000đ"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                    <!-- Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mô tả:"
                            android:textSize="16sp"
                            android:textColor="#4B5563" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nạp tiền mua lượt đăng tin"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:gravity="end" />

                    </LinearLayout>

                    <!-- Post Quota -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#F0FDF4"
                        android:padding="12dp"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎁 Bạn sẽ nhận được:"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                        <TextView
                            android:id="@+id/tvPostQuota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giảm quota từ 20 xuống 10 (thêm 10 lượt đăng)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- QR Code Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 Quét mã QR để thanh toán"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- QR Code Container -->
                    <FrameLayout
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:background="#F9FAFB"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progressQrCode"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#10B981" />

                    </FrameLayout>

                    <!-- QR Status -->
                    <TextView
                        android:id="@+id/tvQrStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đang tạo mã QR..."
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Instructions -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Mở ứng dụng ngân hàng của bạn\n• Chọn tính năng quét QR\n• Quét mã QR phía trên\n• Xác nhận thanh toán"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:lineSpacingExtra="2dp"
                        android:background="#F9FAFB"
                        android:padding="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Hủy"
            android:textColor="#EF4444"
            app:backgroundTint="@android:color/white"
            app:strokeColor="#EF4444"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Kiểm tra trạng thái"
                android:textColor="@android:color/white"
                app:backgroundTint="#10B981"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button" />

            <ProgressBar
                android:id="@+id/progressCheckStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
