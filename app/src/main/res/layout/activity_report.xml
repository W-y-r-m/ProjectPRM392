<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- Nút quay về -->
        <Button
            android:id="@+id/btnBackReport"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Quay về"
            android:backgroundTint="#4267B2"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi báo cáo người dùng"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="20dp" />


        <!-- Chọn user để report -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn người dùng cần report:"
            android:textColor="#333"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />
        <Spinner
            android:id="@+id/spinnerUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />


        <!-- Chọn job của user đó -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn job muốn report (có thể bỏ trống):"
            android:textColor="#333"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />
        <Spinner
            android:id="@+id/spinnerJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nội dung báo cáo"
            android:textColor="#333"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Nhập nội dung báo cáo"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSendReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gửi báo cáo"
            android:layout_marginTop="24dp"
            android:backgroundTint="#4267B2"
            android:textColor="#fff"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
